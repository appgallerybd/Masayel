# Firebase কনসোল → Project Settings → General → Your apps → Web app থেকে পাবে
# এগুলো পাবলিক/ক্লায়েন্ট-সাইড কনফিগ — এগুলো গোপনীয় না
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase কনসোল → Project Settings → Service Accounts → Generate new private key
# ডাউনলোড হওয়া পুরো .json ফাইলের কনটেন্ট এক লাইনে (স্ট্রিং হিসেবে) এখানে বসাও
# ⚠️ এটা অত্যন্ত স্পর্শকাতর — গিটে কখনো কমিট হবে না (.gitignore এ আছে),
# শুধু .env.local (স্থানীয়) আর Vercel-এর Environment Variables এ বসাও।
FIREBASE_SERVICE_ACCOUNT_KEY=
